<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="antialiased">

  <!-- Hero -->
  <header class="relative overflow-hidden border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 pt-16 pb-10 text-center">
      <p class="font-display text-gold text-sm tracking-[0.35em] mb-3">MEMBER ROSTER</p>
      <h1 class="font-display glow-text text-4xl md:text-6xl font-700 text-white tracking-widest uppercase">
        <%= familyName %>
      </h1>
      <p class="text-white/50 mt-3 tracking-wide"><%= familySlogan %></p>

      <div class="flex items-center justify-center gap-8 mt-8">
        <div class="text-center">
          <div class="font-display text-3xl text-gold font-700"><span id="stat-active"><%= activeMembers %></span></div>
          <div class="text-xs text-white/40 uppercase tracking-widest mt-1">Online / Active</div>
        </div>
        <div class="w-px h-10 bg-white/10"></div>
        <div class="text-center">
          <div class="font-display text-3xl text-white font-700"><span id="stat-total"><%= totalMembers %></span></div>
          <div class="text-xs text-white/40 uppercase tracking-widest mt-1">Total Members</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Search & Filters -->
  <div class="max-w-6xl mx-auto px-6 pt-8">
    <input
      id="searchInput"
      type="text"
      placeholder="Search by IC name or Discord tag..."
      class="search-input w-full rounded-lg px-4 py-3 text-sm text-white placeholder-white/30"
    />

    <div class="flex flex-wrap gap-2 mt-4">
      <button class="filter-btn active border border-white/10 rounded-full px-4 py-1.5 text-xs text-white/70" data-rank="ALL">All Ranks</button>
      <% Object.entries(rankLabels).forEach(([key, label]) => { %>
        <button class="filter-btn border border-white/10 rounded-full px-4 py-1.5 text-xs text-white/70" data-rank="<%= key %>"><%= label %></button>
      <% }) %>
      <span class="w-px bg-white/10 mx-1"></span>
      <button class="filter-btn active border border-white/10 rounded-full px-4 py-1.5 text-xs text-white/70" data-status="ALL">All Status</button>
      <button class="filter-btn border border-white/10 rounded-full px-4 py-1.5 text-xs text-white/70" data-status="ACTIVE">Active</button>
      <button class="filter-btn border border-white/10 rounded-full px-4 py-1.5 text-xs text-white/70" data-status="INACTIVE">Inactive</button>
    </div>
  </div>

  <!-- Member Grid -->
  <main class="max-w-6xl mx-auto px-6 py-10">
    <div id="memberGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% members.forEach(m => { %>
        <div
          class="member-card glass-card rounded-2xl p-6 text-center cursor-pointer"
          data-id="<%= m.id %>"
        >
          <img
            src="<%= m.avatarUrl || 'https://api.dicebear.com/7.x/shapes/svg?seed=' + encodeURIComponent(m.icName) %>"
            alt="<%= m.icName %>"
            class="avatar-ring w-20 h-20 rounded-full object-cover mx-auto mb-4"
          />
          <h3 class="font-display text-lg text-white font-600"><%= m.icName %></h3>
          <p class="text-white/40 text-xs mt-0.5">@<%= m.discordTag %></p>
          <div class="flex items-center justify-center gap-2 mt-3">
            <span class="badge badge-<%= m.rank.toLowerCase() %>"><%= rankLabels[m.rank] %></span>
          </div>
          <div class="flex items-center justify-center gap-1.5 mt-3">
            <span class="status-dot status-<%= m.status.toLowerCase() %>"></span>
            <span class="text-[11px] text-white/40 uppercase tracking-wider"><%= m.status %></span>
          </div>
          <% if (m.specialty) { %>
            <p class="text-white/30 text-xs mt-2 truncate"><%= m.specialty %></p>
          <% } %>
        </div>
      <% }) %>
    </div>
    <p id="emptyState" class="hidden text-center text-white/30 py-16 font-display tracking-widest">NO MEMBERS FOUND</p>
  </main>

  <footer class="text-center text-white/20 text-xs py-8 border-t border-white/5">
    &copy; <%= new Date().getFullYear() %> <%= familyName %> &middot; Built for the family.
  </footer>

  <!-- Member Detail Modal -->
  <div id="memberModal" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center px-4">
    <div class="glass-card rounded-2xl max-w-md w-full p-8 relative bg-panel">
      <button id="modalClose" class="absolute top-4 right-4 text-white/40 hover:text-white text-xl leading-none">&times;</button>
      <div id="modalContent" class="text-center"></div>
    </div>
  </div>

  <script src="/js/roster.js"></script>
</body>
</html>
