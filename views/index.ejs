<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="antialiased">

  <section class="hero-wrap">
    <div class="hero-bg"></div>
    <div id="snowContainer"></div>

    <div class="hero-title">
      <h1 class="font-display glow-text text-5xl md:text-7xl font-700 text-white tracking-widest uppercase">
        <%= familyName %>
      </h1>
      <p class="text-white/40 mt-3 tracking-[0.3em] text-xs md:text-sm uppercase">
        <%= familySlogan %>
      </p>
    </div>

    <div class="logo-panel">
      <% if (familyLogoUrl) { %>
        <img src="<%= familyLogoUrl %>" alt="<%= familyName %> logo" class="logo-float" />
        <% } else { %>
          <span class="font-display text-white/15 text-6xl tracking-widest select-none">LOGO</span>
          <% } %>
    </div>

    <a href="/roster" class="enter-btn font-display font-700 tracking-[0.2em] uppercase text-sm">
      <%= familyName %>
    </a>

    <p class="relative z-10 text-white/20 text-[11px] mt-16 text-center">
      &copy; <%= new Date().getFullYear() %>
        <%= familyName.split(' ')[0] %>
      <% if (designCredit) { %> &middot; Designed by <%= designCredit %><% } %>
      <% if (musicCredit) { %> &middot; Music credits by <%= musicCredit %><% } %>
    </p>
  </section>

  <% if (backgroundMusicUrl) { %>
    <audio id="bgMusic" src="<%= backgroundMusicUrl %>" loop></audio>
    <button id="musicToggle" class="music-toggle" aria-label="Toggle music">
      <svg id="iconPause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-white/70">
        <rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>
      </svg>
      <svg id="iconPlay" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-white/70 hidden">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>
  <% } %>

  <script>
    // Falling snow effect
    (function () {
      const container = document.getElementById(' snowContainer'); const count = window.innerWidth < 640 ? 18 : 32; for
        (let i = 0; i < count; i++) {
          const flake = document.createElement('span'); flake.className = 'snow';
        flake.textContent = '❋'; flake.style.left = Math.random() * 100 + 'vw'; flake.style.fontSize = (8 + Math.random()
          * 10) + 'px'; flake.style.animationDuration = (8 + Math.random() * 10) + 's';
        flake.style.animationDelay = (Math.random() * 8) + 's'; container.appendChild(flake);
      }
    })(); // Background
          music toggle(function () {
      const audio = document.getElementById('bgMusic'); const
        btn = document.getElementById('musicToggle'); if (!audio || !btn) return; const
          iconPlay = document.getElementById('iconPlay'); const iconPause = document.getElementById('iconPause'); let
            playing = false; btn.addEventListener('click', () => {
              if (playing) {
                audio.pause();
                iconPlay.classList.remove('hidden');
                iconPause.classList.add('hidden');
              } else {
                audio.play().catch(() => { });
                iconPlay.classList.add('hidden');
                iconPause.classList.remove('hidden');
              }
              playing = !playing;
            });
    })();
  </script>
</body>

</html>