<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="antialiased">

  <%- include('partials/page-transition') %>

  <section class="hero-wrap">
    <div class="hero-bg"></div>
    <div id="snowContainer"></div>

    <div class="hero-title intro-fade intro-delay-1">
      <h1 class="font-display glow-text text-5xl md:text-7xl font-700 text-white tracking-widest uppercase">
        <%= familyName %>
      </h1>
      <p class="text-white/40 mt-3 tracking-[0.3em] text-xs md:text-sm uppercase">
        <%= familySlogan %>
      </p>
    </div>

    <div class="logo-panel intro-fade intro-delay-2">
      <% if (familyLogoVideoUrl) { %>
        <video
          class="logo-video"
          autoplay
          loop
          muted
          playsinline
          onerror="this.style.display='none'; var f=document.getElementById('logoFallback'); if(f){f.style.display='flex';}"
        >
          <source src="<%= familyLogoVideoUrl %>" type="video/mp4" />
        </video>
        <% if (familyLogoUrl) { %>
          <div id="logoFallback" style="display:none;" class="w-full h-full items-center justify-center">
            <img src="<%= familyLogoUrl %>" alt="<%= familyName %> logo" class="logo-float" />
          </div>
        <% } %>
      <% } else if (familyLogoUrl) { %>
        <img src="<%= familyLogoUrl %>" alt="<%= familyName %> logo" class="logo-float" />
      <% } else { %>
        <span class="font-display text-white/15 text-6xl tracking-widest select-none">LOGO</span>
      <% } %>
    </div>

    <a href="/roster" class="enter-btn font-display font-700 tracking-[0.2em] uppercase text-sm intro-fade intro-delay-3">
      <%= familyName %>
    </a>

    <p class="relative z-10 text-white/20 text-[11px] mt-16 text-center intro-fade intro-delay-4">
      &copy; <%= new Date().getFullYear() %>
        <%= familyName.split(' ')[0] %>
      <% if (designCredit) { %> &middot; Designed by <%= designCredit %><% } %>
      <% if (musicCredit) { %> &middot; Music credits by <%= musicCredit %><% } %>
    </p>
  </section>

  <%- include('partials/music-player', { backgroundMusicUrl: backgroundMusicUrl }) %>

<script>
  (function () {
    var container = document.getElementById('snowContainer');
    if (!container) { return; }
    var count = window.innerWidth < 640 ? 18 : 32;
    for (var i = 0; i < count; i++) {
      var flake = document.createElement('span');
      flake.className = 'snow';
      flake.textContent = '❋';
      flake.style.left = Math.random() * 100 + 'vw';
      flake.style.fontSize = (8 + Math.random() * 10) + 'px';
      flake.style.animationDuration = (8 + Math.random() * 10) + 's';
      flake.style.animationDelay = (Math.random() * 8) + 's';
      container.appendChild(flake);
    }
  })();
</script>
</body>

</html>