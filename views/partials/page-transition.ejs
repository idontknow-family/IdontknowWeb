<div id="pageTransitionOverlay" class="page-transition-overlay">
  <div class="page-transition-spinner"></div>
</div>

<script>
  (function () {
    var overlay = document.getElementById('pageTransitionOverlay');
    if (!overlay) { return; }

    function hideOverlay() {
      if (overlay.classList.contains('is-hidden')) return;
      overlay.classList.add('is-hidden');
    }

    // ปลดหน้าดำทันทีเมื่อพร้อม หรือล็อคเวลาไม่เกิน 0.8 วินาทีแน่นอน
    window.addEventListener('load', hideOverlay);
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(hideOverlay, 300);
    });
    setTimeout(hideOverlay, 800); // Safety net ตัดจบแน่นอน

    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href]');
      if (!link) { return; }
      if (link.target === '_blank') { return; }
      if (link.closest('.music-widget')) { return; }

      var url;
      try {
        url = new URL(link.href, window.location.href);
      } catch (err) {
        return;
      }
      if (url.origin !== window.location.origin) { return; }
      if (url.href === window.location.href) { return; }

      e.preventDefault();
      overlay.classList.remove('is-hidden');
      overlay.classList.add('is-entering');
      setTimeout(function () {
        window.location.href = url.href;
      }, 260);
    });
  })();
</script>