# === Database (Railway PostgreSQL) ===
# Railway auto-injects DATABASE_URL when you add a PostgreSQL service and
# reference it in your app service's variables as ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/fivem_roster?schema=public"

# === App ===
PORT=3000
NODE_ENV=development

# === Session ===
SESSION_SECRET="change-this-to-a-long-random-string"

# === Family Branding (shown on public roster page) ===
FAMILY_NAME="HOUSE OF RAVEN"
FAMILY_SLOGAN="Loyalty. Power. Legacy."
# Direct image URL for the animated floating logo in the hero panel (png/svg with transparent bg looks best)
FAMILY_LOGO_URL=""
# Comma-separated names shown in the "Supervised By" section (leave blank to hide the section)
SUPERVISORS=""
# Direct URL to an mp3/ogg file for background music (leave blank to hide the music toggle button)
BACKGROUND_MUSIC_URL=""
# Optional footer credit lines
DESIGN_CREDIT=""
MUSIC_CREDIT=""

# === Default Admin Seed (used only by prisma/seed.js) ===
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
